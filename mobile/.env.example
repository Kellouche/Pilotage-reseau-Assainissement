# Configuration de build mobile

# L'URL de l'API est injectée à la compilation via --dart-define
# (voir mobile/lib/services/api_service.dart).
# Le port doit correspondre à API_PORT côté backend (config/settings.py).
#
# Lancement local :
#   flutter run --dart-define=API_BASE_URL=http://127.0.0.1:<API_PORT>
#
# Téléphone physique sur le même réseau :
#   flutter run --dart-define=API_BASE_URL=http://192.168.1.10:<API_PORT>
API_BASE_URL=http://127.0.0.1:<API_PORT>
