# Configuration de build mobile

# L'URL de l'API est injectée à la compilation via --dart-define
# (voir mobile/lib/services/api_service.dart).
#
# Lancement local :
#   flutter run --dart-define=API_BASE_URL=http://127.0.0.1:5002
#
# Téléphone physique sur le même réseau :
#   flutter run --dart-define=API_BASE_URL=http://192.168.1.10:5002
#
# Sans dart-define, la valeur par défaut est http://127.0.0.1:5002.
API_BASE_URL=http://127.0.0.1:5002
